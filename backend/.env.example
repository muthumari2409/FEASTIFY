# ---------- FEASTIFY backend settings ----------
# Copy this file to ".env" and fill in your own values.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers -> Python)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority&appName=Feastify
DB_NAME=feastify

# Long random text used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

JWT_EXPIRES_HOURS=24
APP_TIMEZONE=Asia/Kolkata
COOKIE_SECURE=false
PORT=5000

# The two admin accounts (hashed and stored in MongoDB by: python seed_admins.py)
ADMIN1_USERNAME=admin1
ADMIN1_PASSWORD=Admin@123
ADMIN2_USERNAME=admin2
ADMIN2_PASSWORD=Admin@456
